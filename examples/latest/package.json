{
  "name": "example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:vite": "vite",
    "dev:relay": "relay-compiler --watch",
    "build": "relay-compiler --validate && tsc --noEmit && vite build",
    "test": "concurrently \"npm:build\" && playwright test"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-relay": "^21.0.1",
    "relay-runtime": "21.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^20.10.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "@types/react-relay": "^16.0.5",
    "@types/relay-runtime": "^14.1.19",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-relay": "^21.0.1",
    "concurrently": "^8.2.2",
    "relay-compiler": "^21.0.1",
    "typescript": "^5.3.3",
    "vite": "^8.0.0",
    "vite-plugin-relay": "workspace:*"
  },
  "relay": {
    "src": "./src",
    "schema": "./schema.graphql",
    "language": "typescript",
    "eagerEsModules": true
  }
}
